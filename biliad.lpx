#!name=哔哩哔哩去广告 · 自用
#!desc=开屏 / 首页推荐 / 动态 / 播放页(UP主推荐) / 直播 / 我的页 广告清理；JSON 与 grpc-web 双路径；零第三方依赖、零外发请求、异常一律原样放行
#!author=YG
#!homepage=https://github.com/XwFounder/bili-clean
#!icon=https://github.com/XwFounder/bili-clean/raw/main/icon.png

[MITM]
hostname = %APPEND% app.bilibili.com, app.biliapi.net, grpc.biliapi.net, api.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, manga.bilibili.com

[Rewrite]
# 开屏 IP 素材请求
^https?:\/\/app\.bilibili\.com\/x\/resource\/ip(\?|$) reject-dict
# 开屏展示接口（素材列表走 biliad.js 清空）
^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show(\?|$) reject-dict
# 首页右上角活动入口
^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity(\?|$) reject-dict
# 搜索默认词 / 搜索推荐词广告
^https?:\/\/app\.bilibili\.com\/x\/v2\/search\/defaultwords(\?|$) reject-dict
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d+\/Search\/recommend_words(\?|$) reject-dict
# 搜索 grpc 默认词
^https?:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v1\.Search\/Default(\?|$) reject
# 会员购广告上报 / 播放器小卡片 / 番剧相关推荐
^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report(\?|$) reject-dict
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/cards(\?|$) reject-dict
^https?:\/\/api\.bilibili\.com\/pgc\/season\/app\/related\/recommend(\?|$) reject-dict
# 动态话题推广
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr(\?|$) reject-dict
# 漫画开屏
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d+\.Comic\/(Flash|ListFlash)(\?|$) reject-dict

[Script]
http-response ^https:\/\/app\.bilibili\.com\/x\/(v2\/(splash\/list|feed\/index|account\/mine)|resource\/show\/tab) script-path=https://raw.githubusercontent.com/XwFounder/bili-clean/main/biliad.js, requires-body=true, timeout=10, tag=biliad-json
http-response ^https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom script-path=https://raw.githubusercontent.com/XwFounder/bili-clean/main/biliad.js, requires-body=true, timeout=10, tag=biliad-live
http-response ^https:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/dynamic_(new|history) script-path=https://raw.githubusercontent.com/XwFounder/bili-clean/main/biliad.js, requires-body=true, timeout=10, tag=biliad-dyn
http-response ^https:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(viewunite\.v1\.View\/View|view\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll)(\?.*)?$ script-path=https://raw.githubusercontent.com/XwFounder/bili-clean/main/biliad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=biliad-proto
